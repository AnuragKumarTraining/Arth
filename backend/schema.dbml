enum transaction_status {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum transaction_type {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
}

table branches {
  id serial [pk, not null, increment]
  branch_code varchar [not null, unique]
  branch_name varchar(100) [not null]
  ifsc_code varchar(11) [not null]
  address text [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
}

table customers {
  id serial [pk, not null, increment]
  email varchar(255) [not null, unique]
  password_hash text [not null]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  date_of_birth date [not null]
  phone_number varchar(20) [not null, unique]
  national_id varchar(50) [not null, unique]
  address text [not null]
  account_type varchar(20) [not null]
  branch_id varchar [not null]
  is_active boolean [not null, default: false]
  kyc_status varchar(30) [not null, default: 'PENDING_ADMIN_APPROVAL']
  created_at "timestamp with time zone" [not null, default: `now()`]
}

table pending_registrations {
  email text [pk, not null]
  password text [not null]
  first_name text [not null]
  last_name text [not null]
  date_of_birth date [not null]
  phone_number text [not null]
  national_id text [not null]
  address text [not null]
  account_type text [not null]
  hashed_otp text [not null]
  failed_attempts integer [not null, default: 0]
  resend_available_at "timestamp with time zone" [not null]
  expires_at "timestamp with time zone" [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
}

table accounts {
  id serial [pk, not null, increment]
  account_id uuid [unique, default: `gen_random_uuid()`]
  account_number varchar(20) [not null, unique]
  account_type varchar(20) [not null]
  balance text [not null, default: '0.00']
  customer_id integer [not null]
  branch_id integer [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
}

table beneficiaries {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  customer_id integer [not null]
  name varchar(100) [not null]
  account_number varchar(20) [not null]
  ifsc_code varchar(11) [not null]
  bank_name varchar(100) [not null]
  is_verified boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
}

table auth_sessions {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  customer_id integer [not null]
  refresh_token varchar(255) [not null, unique]
  is_revoked boolean [not null, default: false]
  expires_at timestamp [not null]
  created_at timestamp [not null, default: `now()`]
}

table transactions {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  reference_number varchar(50) [not null, unique]
  sender_account_id integer
  receiver_account_id integer
  external_account_number varchar(50)
  external_routing_code varchar(20)
  external_bank_name varchar(100)
  amount "numeric(12, 2)" [not null]
  type transaction_type [not null]
  status transaction_status [not null, default: 'PENDING']
  description text
  created_at timestamp [not null, default: `now()`]
}

ref: customers.branch_id > branches.id

ref: accounts.customer_id > customers.id

ref: accounts.branch_id > branches.id

ref: auth_sessions.customer_id > customers.id

ref: transactions.sender_account_id > accounts.id

ref: transactions.receiver_account_id > accounts.id

ref: beneficiaries.customer_id > customers.id